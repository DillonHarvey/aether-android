# Public GitHub repository: project source, build inputs and the root README only.
# Local tests, engineering records and owner inputs remain on disk.
/*
!/.clang-format
!/.editorconfig
!/.gitattributes
!/.gitignore
!/CMakeLists.txt
!/CMakePresets.json
!/README.md
!/apps/
!/cmake/
!/include/
!/src/
!/third_party/
!/tools/
!/docs/
/docs/*
!/docs/assets/
/docs/assets/*
!/docs/assets/aether-banner.svg

# Only tools needed to build, install, inspect or publish the project.
/tools/*
!/tools/angle_sources.py
!/tools/build.ps1
!/tools/collect-diagnostics.ps1
!/tools/common.ps1
!/tools/compile-privacy.py
!/tools/install.ps1
!/tools/package-runtime.py
!/tools/publish-source.py
!/tools/register-github-upload.ps1
!/tools/verify-dependencies.py
!/tools/verify-distribution.py

# Exclude test suites, fixtures, vendor examples and documentation everywhere.
**/[Tt]est/
**/[Tt]ests/
**/testing/
**/unit_test/
**/fixtures/
**/doctest/
**/sample/
**/samples/
**/example/
**/examples/
**/benchmark/
**/benchmarks/
/third_party/**/doc/
/third_party/**/docs/
/third_party/boost/boost/core/lightweight_test*.hpp
/third_party/boost/boost/detail/lightweight_test*.hpp
/third_party/boost/boost/iostreams/filter/test.hpp
/third_party/boost/boost/iterator/new_iterator_tests.hpp
/third_party/boost/boost/math/tools/test_value.hpp
/third_party/boost/boost/mpl/aux_/test.hpp
/third_party/boost/boost/numeric/interval/detail/test_input.hpp
/third_party/boost/boost/pending/iterator_tests.hpp
*_test.cpp
*_test.cc
*_tests.cpp
*_tests.py
test_*.py
test_*.cpp
test_*.c
*.[mM][dD]
*.markdown
!/README.md

# Generated output, private configuration, binaries and archives never belong here.
/out/
/[Aa][Pp][Kk]/
**/.git/
**/.vs/
**/__pycache__/
**/.env
**/.env.*
CMakeUserPresets.json
*.user
*.pyc
*.pyo
*.log
*.tmp
*.bak
*.apk
*.apks
*.xapk
*.apkm
*.aab
*.dex
*.so
*.exe
*.dll
*.pdb
*.obj
*.lib
*.zip
*.7z
*.tar
*.gz
*.pfx
*.p12
*.pem
*.key
*.keystore
*.jks
