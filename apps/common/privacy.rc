#include <windows.h>
#include "privacy_ids.h"

IDD_PRIVACY DIALOGEX 0, 0, 460, 350
STYLE DS_SETFONT | WS_POPUP | WS_MINIMIZEBOX
EXSTYLE WS_EX_CONTROLPARENT | WS_EX_APPWINDOW
FONT 9, "Segoe UI"
BEGIN
    LTEXT "AETHER  /  PRIVACY", IDC_PRIVACY_LABEL, 12, 10, 380, 14
    LTEXT "Privacy and permissions", IDC_PRIVACY_HEADING, 12, 28, 380, 28
    CONTROL "Back", 103, "Button", BS_OWNERDRAW | WS_TABSTOP, 420, 8, 28, 28
    EDITTEXT IDC_PRIVACY_TEXT, 12, 66, 436, 242, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL "Back", IDCANCEL, "Button", BS_OWNERDRAW | WS_TABSTOP, 364, 320, 84, 18
END
